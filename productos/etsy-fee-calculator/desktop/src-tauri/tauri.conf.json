{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fee and Price Calculator",
  "version": "1.4.0",
  "identifier": "com.drakhtharsoftware.feecalculator",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node prep.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Fee & Price Calculator · DrakhtharSoftware",
        "width": 1180,
        "height": 820,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "publisher": "DrakhtharSoftware",
    "copyright": "© 2026 DrakhtharSoftware",
    "category": "Business",
    "shortDescription": "Fee and price calculator for Etsy sellers",
    "longDescription": "Calculate Etsy fees, profit and margin per product, and find the price you need for a target profit. Works offline. One-time purchase, no subscription.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Spanish", "French", "German", "Italian"],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
